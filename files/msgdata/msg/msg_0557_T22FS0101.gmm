<?xml version="1.0"?>
<body language="English">
	<row id="msg_0557_T22FS0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When you first catch a Pokémon,\nit may be weak.\rBut it will eventually grow to\nbe strong.\rIt’s important to treat Pokémon\nwith love.</language>
	</row>
	<row id="msg_0557_T22FS0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pokémon can hold items like a Potion\nor an Antidote.\rBut they don’t appear to know how\nto use man-made items.</language>
	</row>
	<row id="msg_0557_T22FS0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Egg?\r</language>
	</row>
	<row id="msg_0557_T22FS0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Egg?\r</language>
	</row>
	<row id="msg_0557_T22FS0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} received\nthe Egg from the assistant!</language>
	</row>
	<row id="msg_0557_T22FS0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enjoy the HM Egg.\r</language>
	</row>
	<row id="msg_0557_T22FS0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Enjoy the HM Egg.\r</language>
	</row>
	<row id="msg_0557_T22FS0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your party is full.\nYou cannot take the Egg yet.\fI’ll wait here for you.</language>
	</row>
	<row id="msg_0557_T22FS0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What?\nI never expected you’d say no!\fYou must be kidding, right?\rProfessor Elm really wants you to\ntake care of it...\n\n</language>
	</row>
	<row id="msg_0557_T22FS0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0},\nwill you take this Egg? {YESNO 0}</language>
	</row>
	<row id="msg_0557_T22FS0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0},\nwill you take this Egg? {YESNO 0}</language>
	</row>
</body>
